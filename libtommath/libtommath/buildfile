# Note that upstream keeps all the library sources in its root directory,
# which we symlink file by file (see bn_s_mp_rand_platform.c.patch for the
# one source file that we had to patch).
#
lib{tommath}: libul{tommath}: {h c}{*}

libs{tommath}: def{tommath}: include = ($c.target.system == 'win32-msvc')
def{tommath}: libul{tommath}

# Build options.
#
src_pfx = [dir_path] $src_root/libtommath/

c.poptions =+ "-I$src_pfx"

if ($c.target.system == 'win32-msvc')
  c.poptions += -D_CRT_SECURE_NO_WARNINGS -D_CRT_NONSTDC_NO_DEPRECATE

if ($c.target.system == 'mingw32')
  c.loptions += -Wl,--export-all-symbols

# Export options.
#
lib{tommath}: c.export.poptions = "-I$src_pfx"

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{tommath}: bin.lib.version = "-$version.project_id"
else
  lib{tommath}: bin.lib.version = "-$version.major.$version.minor"

# Only install the public header and directly into, say, /usr/include/, as
# upstream does. The rest are private headers.
#
h{tommath}@./: install = include/
h{*}: install = false
